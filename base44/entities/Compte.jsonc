{
  "name": "Compte",
  "type": "object",
  "properties": {
    "matricule": {
      "type": "string"
    },
    "nom": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "default": "Membre"
    },
    "couleur": {
      "type": "string",
      "default": "#ff5722"
    },
    "photo": {
      "type": "string"
    },
    "statut": {
      "type": "string",
      "enum": [
        "Actif",
        "Banni",
        "Exclu"
      ],
      "default": "Actif"
    },
    "ip_bannie": {
      "type": "string"
    }
  },
  "required": [
    "matricule",
    "nom",
    "password"
  ]
}