{
  "name": "Compte",
  "type": "object",
  "properties": {
    "matricule": {
      "type": "string"
    },
    "nom": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "default": "Membre"
    }
  },
  "required": [
    "matricule",
    "nom",
    "password"
  ]
}