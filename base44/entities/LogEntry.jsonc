{
  "name": "LogEntry",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "Ajout",
        "Suppression"
      ]
    },
    "detail": {
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "role": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "detail",
    "user",
    "role"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}