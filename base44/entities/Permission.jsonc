{
  "name": "Permission",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "Administrateur",
        "Jefe",
        "Soldat"
      ]
    },
    "movements": {
      "type": "boolean",
      "default": false,
      "description": "Voir la comptabilit\u00e9 (mouvements)"
    },
    "movements_add": {
      "type": "boolean",
      "default": false,
      "description": "Ajouter un mouvement"
    },
    "movements_delete": {
      "type": "boolean",
      "default": false,
      "description": "Supprimer un mouvement"
    },
    "objets": {
      "type": "boolean",
      "default": true
    },
    "bijoux": {
      "type": "boolean",
      "default": true
    },
    "categories": {
      "type": "boolean",
      "default": true
    },
    "bijouxCategories": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "role"
  ]
}