{
  "name": "Permission",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "Administrateur",
        "Jefe",
        "Soldat"
      ]
    },
    "movements": {
      "type": "boolean",
      "default": false,
      "description": "Voir la comptabilit\u00e9 (mouvements)"
    },
    "movements_add": {
      "type": "boolean",
      "default": false,
      "description": "Ajouter un mouvement"
    },
    "movements_delete": {
      "type": "boolean",
      "default": false,
      "description": "Supprimer un mouvement"
    },
    "objets": {
      "type": "boolean",
      "default": true,
      "description": "Voir les objets"
    },
    "objets_add": {
      "type": "boolean",
      "default": true,
      "description": "Ajouter un objet"
    },
    "objets_delete": {
      "type": "boolean",
      "default": true,
      "description": "Supprimer un objet"
    },
    "bijoux": {
      "type": "boolean",
      "default": true,
      "description": "Voir les bijoux"
    },
    "bijoux_add": {
      "type": "boolean",
      "default": true,
      "description": "Ajouter un bijou"
    },
    "bijoux_delete": {
      "type": "boolean",
      "default": true,
      "description": "Supprimer un bijou"
    },
    "categories": {
      "type": "boolean",
      "default": true,
      "description": "Voir les cat\u00e9gories"
    },
    "categories_add": {
      "type": "boolean",
      "default": true,
      "description": "Ajouter une cat\u00e9gorie"
    },
    "categories_delete": {
      "type": "boolean",
      "default": true,
      "description": "Supprimer une cat\u00e9gorie"
    },
    "bijouxCategories": {
      "type": "boolean",
      "default": true,
      "description": "Voir les cat\u00e9gories de bijoux"
    },
    "bijouxCategories_add": {
      "type": "boolean",
      "default": true,
      "description": "Ajouter une cat\u00e9gorie de bijoux"
    },
    "bijouxCategories_delete": {
      "type": "boolean",
      "default": true,
      "description": "Supprimer une cat\u00e9gorie de bijoux"
    }
  },
  "required": [
    "role"
  ]
}